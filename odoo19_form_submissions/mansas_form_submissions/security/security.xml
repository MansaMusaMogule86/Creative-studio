<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_form_submissions" model="ir.module.category">
        <field name="name">Website Form Submissions</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_form_submissions" model="res.groups.privilege">
        <field name="name">Form Submissions</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_form_submissions"/>
    </record>

    <record id="group_form_submission_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can read and process website form submissions.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_form_submissions"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_form_submission_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can also delete submissions and manage services and API keys.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_form_submissions"/>
        <field name="implied_ids" eval="[(4, ref('group_form_submission_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company: users only see submissions of their allowed companies. -->
    <record id="rule_form_submission_company" model="ir.rule">
        <field name="name">Form submissions: multi-company</field>
        <field name="model_id" ref="model_mansas_form_submission"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_form_api_key_company" model="ir.rule">
        <field name="name">Form API keys: multi-company</field>
        <field name="model_id" ref="model_mansas_form_api_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
