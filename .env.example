# ── Build (Vercel → Settings → Environment Variables, Production) ─────────────
# Public site origin for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://mansasmoguls.com
# production = indexable. Anything else (e.g. staging) = noindex + robots Disallow.
SITE_ENV=production
# Optional override for the form's endpoint. Default: same-origin /api/leads.
PUBLIC_INQUIRY_ENDPOINT=

# ── Lead delivery (server-only; never prefix these with PUBLIC_) ─────────────
# Supabase: durable store for every inquiry. Apply supabase/migrations/*_leads.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_LEADS_TABLE=leads
# Random secret used to hash visitor IPs for rate limiting (no raw IPs are stored).
LEADS_IP_SALT=
LEADS_RATE_LIMIT_PER_MINUTE=5

# HighLevel (GoHighLevel) CRM forwarding. Leave empty to store in Supabase only.
# Confirm field names in a HighLevel sandbox first (docs/ghl-integration/08).
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_PIPELINE_ID=
HIGHLEVEL_PIPELINE_STAGE_ID=
# HIGHLEVEL_API_VERSION=2021-07-28
