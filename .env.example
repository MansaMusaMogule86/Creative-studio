# ── Build (Vercel → Settings → Environment Variables, Production) ─────────────
# Public site origin for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://mansasmoguls.com
# production = indexable. Anything else (e.g. staging) = noindex + robots Disallow.
SITE_ENV=production
# Optional override for the form's endpoint. Default: same-origin /api/leads.
PUBLIC_INQUIRY_ENDPOINT=

# ── Lead delivery (server-only; never prefix these with PUBLIC_) ─────────────
# Odoo (crm.mansasmoguls.com): stores each inquiry as a Website Form Submission
# (module in odoo19_form_submissions/). Required to receive inquiries.
# Generate the key in Odoo: Website Submissions → Configuration → API Keys.
# Server-only secret: never prefix with PUBLIC_, never commit it.
# It also salts the visitor-IP hash used for rate limiting (no raw IPs are stored or sent).
ODOO_API_KEY=
# ODOO_BASE_URL=https://crm.mansasmoguls.com
# Only if the Odoo server hosts several databases without a dbfilter:
# ODOO_DATABASE=
# Inquiries per visitor per minute on each server instance (Odoo also limits).
LEADS_RATE_LIMIT_PER_MINUTE=10

# HighLevel (GoHighLevel) CRM forwarding. Optional; leave empty to use Odoo only.
# Confirm field names in a HighLevel sandbox first (docs/ghl-integration/08).
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_PIPELINE_ID=
HIGHLEVEL_PIPELINE_STAGE_ID=
# HIGHLEVEL_API_VERSION=2021-07-28
