# HighLevel (GoHighLevel) integration — SERVER-SIDE ONLY.
# Placeholders only. Never commit real values. Never prefix secrets with PUBLIC_
# (Astro exposes PUBLIC_* variables to the browser).

# API
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
HIGHLEVEL_API_VERSION=2021-07-28            # NEEDS CONFIRMATION against current docs
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=replace-with-private-integration-token
HIGHLEVEL_LOCATION_ID=replace-with-location-id

# Pipelines and stages (IDs from the account; discovered once with the pipelines endpoint)
HIGHLEVEL_PIPELINE_ID_SALES=replace-with-pipeline-id
HIGHLEVEL_STAGE_ID_NEW_LEAD=replace-with-stage-id
HIGHLEVEL_PIPELINE_ID_ONBOARDING=replace-with-pipeline-id

# Routing (HighLevel user IDs; optional — workflows can assign instead)
HIGHLEVEL_OWNER_ID_DEFAULT=replace-with-user-id

# Booking (public link to a GHL calendar booking page; safe to expose)
PUBLIC_DISCOVERY_BOOKING_URL=

# Webhooks (only if inbound webhooks are adopted later)
HIGHLEVEL_WEBHOOK_PUBLIC_KEY=replace-with-public-key-from-official-docs

# Lead endpoint protection
LEADS_ALLOWED_ORIGINS=https://your-domain.example
LEADS_RATE_LIMIT_PER_MINUTE=5
# Optional bot protection (service choice needs approval)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Privacy notice version stored with each consent record
PRIVACY_NOTICE_VERSION=draft-0
