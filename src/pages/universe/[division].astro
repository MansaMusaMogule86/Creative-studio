---
import Base from '../../layouts/Base.astro';
import { divisions, type Division } from '../../data/divisions';
import { brand } from '../../config/brand';
import DivisionArt from '../../components/divisions/DivisionArt.astro';

export function getStaticPaths() {
  return divisions.map((d) => ({ params: { division: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Division };
const i = divisions.indexOf(d);
const next = divisions[(i + 1) % divisions.length];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: `${d.name} services`,
  itemListElement: d.services.map((s, n) => ({
    '@type': 'ListItem', position: n + 1,
    item: { '@type': 'Service', name: s.title, description: s.desc, provider: { '@type': 'Organization', name: brand.name } },
  })),
}, {
  // Mirrors the visible breadcrumb (Home / Universe / {division}).
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Universe', item: new URL('/#universe', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.short, item: new URL(`/universe/${d.slug}/`, Astro.site).href },
  ],
}];
// Meta description: the division intro alone stays within ~160 characters.
const metaDescription = d.intro.length <= 158 ? d.intro : `${d.intro.slice(0, 155).trimEnd()}…`;
---
<Base title={`${d.name}: ${d.tagline}`} description={metaDescription} jsonLd={jsonLd}>
  <article class="dv" style={`--a:${d.palette[0]};--b:${d.palette[1]};--c:${d.palette[2]};--ink-d:${d.ink}`}>
    <header class="dv__hero">
      <div class="wrap dv__heroGrid">
        <div class="dv__copy">
          <nav aria-label="Breadcrumb" class="dv__crumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/#universe">Universe</a> <span aria-hidden="true">/</span> <span aria-current="page">{d.short}</span></nav>
          <p class="eyebrow">{d.index}: {d.tagline}</p>
          <h1 class="display">{d.name.split(' ')[0]} <em>{d.name.split(' ').slice(1).join(' ')}</em></h1>
          <p class="lede">{d.intro}</p>
          <div class="dv__ctas">
            <a class="btn" href={`/?service=${d.services[0].slug}#contact`} data-magnetic>Start {/^[aeiou]/i.test(d.short) ? "an" : "a"} {d.short === "AI" ? "AI" : d.short.toLowerCase()} project <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="#services-list">See all {d.services.length} services</a>
          </div>
        </div>
        <figure class="dv__art">
          <DivisionArt division={d} variant="hero" eager />
        </figure>
      </div>
    </header>

    <section id="services-list" class="section dv__list" aria-labelledby="dv-services">
      <div class="wrap">
        <h2 id="dv-services" class="h2">What we <em>do here.</em></h2>
        <ol>
          {d.services.map((s, n) => (
            <li id={s.slug} class="dv__svc" data-reveal>
              <span class="dv__n">{String(n + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <a href={`/?service=${s.slug}#contact`}>Inquire <span class="sr-only">about {s.title}</span> →</a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <nav class="dv__next" aria-label="Next division">
      <a href={`/universe/${next.slug}`} class="wrap" style={`--na:${next.palette[0]}`}>
        <span class="eyebrow">Next world · {next.index}</span>
        <span class="dv__nextName">{next.name} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .dv__hero { overflow-x: clip; padding-top: 140px; padding-bottom: clamp(3rem, 6vw, 6rem); background: radial-gradient(60% 70% at 80% 30%, color-mix(in srgb, var(--a) 45%, transparent), transparent 70%), radial-gradient(40% 50% at 10% 90%, color-mix(in srgb, var(--b) 35%, transparent), transparent 70%); }
  .dv__heroGrid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem; align-items: center; }
  .dv__copy { display: grid; gap: 1.4rem; justify-items: start; }
  .dv__crumb { font-size: 0.86rem; color: var(--ink-3); display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .dv__crumb a { color: var(--ink-2); }
  .dv .eyebrow { color: var(--ink-d); }
  .dv__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .dv__art { position: relative; justify-self: end; width: min(100%, 640px); margin: 0; border-radius: 28px; }
  .dv__art :global(.dart-live) { border-radius: 28px; }
  .dv__art :global(.dart) { border: 1px solid rgb(255 255 255 / 0.95); box-shadow: 0 0 0 1px rgb(216 184 117 / 0.45), 0 50px 90px -50px color-mix(in srgb, var(--ink-d) 55%, transparent); }
  .dv__list ol { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 clamp(1.5rem, 4vw, 4rem); }
  .dv__svc { display: grid; grid-template-columns: 3rem 1fr; column-gap: 1rem; row-gap: 0.4rem; padding-block: 1.8rem; border-top: 1px solid var(--line); scroll-margin-top: 110px; }
  .dv__svc:target { background: linear-gradient(90deg, color-mix(in srgb, var(--a) 22%, transparent), transparent); border-radius: 12px; }
  .dv__n { font-size: 0.78rem; letter-spacing: 0.12em; color: var(--ink-d); padding-top: 0.5rem; grid-row: span 3; }
  .dv__svc h3 { font-family: var(--font-display); font-size: var(--step-2); }
  .dv__svc p { color: var(--ink-2); }
  .dv__svc a { justify-self: start; display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-d); font-weight: 560; font-size: 0.92rem; text-underline-offset: 4px; }
  .dv__next { border-top: 1px solid var(--line); background: var(--white); }
  .dv__next a { display: grid; gap: 0.6rem; padding-block: clamp(3rem, 6vw, 5rem); text-decoration: none; }
  .dv__nextName { font-family: var(--font-display); font-size: var(--step-4); line-height: 1; transition: color 0.4s; }
  .dv__next a:hover .dv__nextName { color: var(--ink-d); }
  @media (max-width: 1023px) { .dv__heroGrid { grid-template-columns: 1fr; } .dv__art { order: -1; justify-self: stretch; width: 100%; border-radius: 26px; } .dv__list ol { grid-template-columns: 1fr; } .dv__hero { padding-top: 110px; } }
</style>
