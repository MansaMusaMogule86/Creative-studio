---
// Render harness for scripts/render-stills.mjs. Only generated when
// RENDER_STILLS=1, so it never ships in a normal build.
import '../../styles/global.css';
import { stills, type Still } from '../../data/stills';
import { brand } from '../../config/brand';
export function getStaticPaths() {
  if (!process.env.RENDER_STILLS) return [];
  return stills.map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Still };
---
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>render {s.id}</title>
<style>
  html, body { margin: 0; background: #f8f7ff; overflow: hidden; }
  html.cut, html.cut body { background: transparent; }
  canvas { display: block; width: 100vw; height: 100vh; }
  .og { position: fixed; inset: 0; padding: 56px 60px; display: grid; align-content: space-between; color: var(--ink); }
  .og__brand { display: flex; align-items: center; gap: 16px; font-family: var(--font-sans); text-transform: uppercase; }
  .og__brand img { height: 96px; width: auto; filter: drop-shadow(0 6px 12px rgb(167 122 48 / 0.3)); }
  .og__brand span { display: grid; gap: 6px; }
  .og__brand b { font-weight: 600; font-size: 22px; letter-spacing: 0.26em; }
  .og__brand small { font-size: 12px; letter-spacing: 0.3em; color: var(--gold-text); }
  .og__rule { width: 120px; height: 1px; background: var(--gold-line); margin-bottom: 18px; }
  .og__title { font-family: var(--font-display); font-size: 112px; line-height: 0.88; letter-spacing: -0.025em; text-transform: uppercase; }
  .og__title em { display: block; text-transform: none; font-size: 1.04em; }
  .og__foot { display: flex; gap: 28px; font-size: 19px; color: var(--ink-2); }
  .og__foot b { font-weight: 560; color: var(--ink); }
</style></head>
<body>
  <canvas data-still={JSON.stringify(s)}></canvas>
  {s.og && (
    <div class="og">
      <div class="og__brand">
        <img src="/brand/emblem-320.webp" width="102" height="96" alt="" />
        <span><b>{brand.nameDisplay}</b><small>{brand.taglineDisplay}</small></span>
      </div>
      <h1 class="og__title">We architect<em class="holo-text">what’s next.</em></h1>
      <div><div class="og__rule"></div><p class="og__foot"><b>{brand.city}</b><span>Digital · AI · Growth · Creative · Strategy</span></p></div>
    </div>
  )}
  <script>
    import { mountSculpture } from '../../scripts/sculpture';
    const c = document.querySelector<HTMLCanvasElement>('canvas')!;
    const s = JSON.parse(c.dataset.still!);
    if (s.transparent) document.documentElement.classList.add('cut');
    mountSculpture(c, { reduceMotion: true, mobile: false, palette: s.palette, still: s, transparent: s.transparent });
    document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(() => ((window as unknown as { __ready: boolean }).__ready = true))));
  </script>
</body></html>
