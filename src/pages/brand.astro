---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { brand } from '../config/brand';
const core = [
  ['Pearl', '#F8F7FF'], ['White', '#FFFFFF'], ['Electric lavender', '#B9A5FF'],
  ['Digital aqua', '#8EE7E8'], ['Soft peach', '#FFC6AC'], ['Deep ink', '#25243C'],
];
const gold = [
  ['Champagne gold', '#D8B875'], ['Royal metallic gold', '#D4A43B'], ['Light gold', '#F5E5BA'],
  ['Antique gold', '#A77A30'], ['Dark gold (text)', '#78531F'],
];
---
<Base title="Brand identity" description="The official Mansas Moguls identity: the golden crowned M emblem, lockups, colour and typography." noindex>
  <section class="section bs">
    <div class="wrap bs__wrap">
      <p class="eyebrow">Official brand identity</p>
      <h1 class="h2">The golden <em>crowned M.</em></h1>
      <p class="lede">A sculptural metallic M with sharp architectural bevels, a floating royal crown and an iridescent orbital ring: heritage and ambition meeting technology and creativity. The liquid-glass sculpture on the homepage is the artistic centrepiece; the crowned M is the identity.</p>

      <div class="bs__grid">
        <figure class="tile tile--wide"><Logo size={88} tagline /><figcaption>Horizontal lockup · light backgrounds</figcaption></figure>
        <figure class="tile tile--dark tile--wide"><Logo size={88} tagline on="dark" /><figcaption>Horizontal lockup · dark backgrounds</figcaption></figure>
        <figure class="tile"><Logo size={150} wordmark={false} /><figcaption>Emblem only</figcaption></figure>
        <figure class="tile tile--dark"><Logo size={150} wordmark={false} on="dark" /><figcaption>Emblem on dark, with champagne aura</figcaption></figure>
        <figure class="tile"><Logo size={40} /><figcaption>Navigation lockup</figcaption></figure>
        <figure class="tile">
          <img src="/apple-touch-icon.png" width="90" height="90" alt="" />
          <img src="/favicon-48.png" width="48" height="48" alt="" />
          <img src="/favicon-32.png" width="32" height="32" alt="" />
          <img src="/favicon-16.png" width="16" height="16" alt="" />
          <figcaption>App icon and favicons at 180, 48, 32 and 16 px</figcaption>
        </figure>
      </div>

      <h2 class="h2 bs__h">Colour</h2>
      <ul class="bs__sw">{core.map(([n, c]) => <li><span style={`background:${c}`}></span><strong>{n}</strong><code>{c}</code></li>)}</ul>
      <h3 class="bs__sub">Gold accents · about 5–10% of any view</h3>
      <ul class="bs__sw">{gold.map(([n, c]) => <li><span style={`background:${c}`}></span><strong>{n}</strong><code>{c}</code></li>)}</ul>

      <h2 class="h2 bs__h">Type</h2>
      <div class="bs__type">
        <p class="display">Instrument Serif</p>
        <p class="bs__sans">Outfit: modern geometric sans for interface, wordmark and body text.</p>
      </div>
      <p class="bs__note">Master artwork: <code>brand-source/crowned-m-master.png</code> (unchanged). Production files are generated by <code>pnpm brand:assets</code>. {brand.name} is always written MANSAS MOGULS in the wordmark.</p>
    </div>
  </section>
</Base>
<style>
  .bs { padding-top: 150px; }
  .bs__wrap { display: grid; gap: 1.6rem; }
  .bs__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-top: 1rem; }
  .tile { margin: 0; min-height: 240px; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: center; position: relative; border-radius: var(--radius); background: var(--white); border: 1px solid var(--line); padding: 2rem 1rem 3.2rem; }
  .tile--wide { grid-column: span 2; }
  .tile--dark { background: radial-gradient(circle at 50% 30%, #34304f, var(--ink) 70%); border-color: rgb(216 184 117 / 0.4); }
  .tile figcaption { position: absolute; bottom: 1rem; inset-inline: 1rem; text-align: center; font-size: 0.82rem; color: var(--ink-3); }
  .tile--dark figcaption { color: #d9d6e8; }
  .bs__h { margin-top: 2rem; }
  .bs__sub { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-text); font-weight: 560; margin-top: 0.6rem; }
  .bs__sw { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .bs__sw li { display: grid; gap: 0.3rem; }
  .bs__sw span { height: 96px; border-radius: 18px; border: 1px solid var(--line); }
  .bs__sw code { font-size: 0.85rem; color: var(--ink-2); }
  .bs__sans { font-size: var(--step-2); }
  .bs__note { color: var(--ink-2); font-size: 0.92rem; }
  @media (max-width: 640px) { .tile--wide { grid-column: auto; } .tile--wide :global(.logo) { --lh: 56px !important; } .tile--wide :global(.logo__tag) { white-space: normal; } }
</style>
