---
import Logo from './Logo.astro';
import { brand } from '../config/brand';
import { divisions } from '../data/divisions';
const featured = divisions.map((d) => d.services[0]).map((s, i) => ({ ...s, division: divisions[i].slug }));
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__intro">
      <Logo size={72} />
      <p class="ftr__tag">{brand.tagline}</p>
      <a href="/#contact" class="btn" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <nav aria-label="Divisions">
      <h2 class="ftr__h">Divisions</h2>
      <ul>{divisions.map((d) => <li><a href={`/universe/${d.slug}`}>{d.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="Featured services">
      <h2 class="ftr__h">Services</h2>
      <ul>{featured.map((s) => <li><a href={`/universe/${s.division}#${s.slug}`}>{s.title}</a></li>)}</ul>
    </nav>
    <div>
      <h2 class="ftr__h">Social</h2>
      {brand.social.length ? (
        <ul>{brand.social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}</ul>
      ) : (
        <p class="ftr__muted">Profiles are on their way.</p>
      )}
      <h2 class="ftr__h ftr__h--gap">Legal</h2>
      <ul>
        <li><a href="/legal/privacy">Privacy policy</a></li>
        <li><a href="/legal/terms">Terms of use</a></li>
      </ul>
    </div>
  </div>
  <div class="ftr__mark" aria-hidden="true"><span>Mansas</span><span><em>Moguls</em></span></div>
  <div class="wrap ftr__base">
    <span>© {year} {brand.name}. {brand.city}.</span>
    <span class="ftr__sig">{divisions.map((d) => d.short).join(' · ')}</span>
  </div>
</footer>

<style>
  .ftr { position: relative; background: var(--white); border-top: 1px solid var(--line); padding-top: clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 2.5rem; }
  .ftr__intro { display: grid; gap: 1.4rem; justify-items: start; align-content: start; }
  .ftr__tag { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; max-width: 14ch; }
  .ftr__h { font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 560; color: var(--ink-3); margin-bottom: 1rem; }
  .ftr__h--gap { margin-top: 2rem; }
  .ftr ul { display: grid; gap: 0.55rem; }
  @media (pointer: coarse) { .ftr ul { gap: 0.1rem; } .ftr ul a { display: inline-flex; align-items: center; min-height: 44px; } }
  .ftr nav a, .ftr ul a { text-decoration: none; color: var(--ink-2); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.4s var(--ease-out), color 0.3s; }
  .ftr ul a:hover { color: var(--ink); background-size: 100% 1px; }
  .ftr__muted { color: var(--ink-3); }
  .ftr__mark {
    display: flex; justify-content: center; gap: 0.18em; margin-top: clamp(3rem, 6vw, 5rem);
    font-family: var(--font-display); font-size: clamp(3.4rem, 15.5vw, 16rem); line-height: 0.82;
    letter-spacing: -0.03em; white-space: nowrap; user-select: none;
    background: linear-gradient(180deg, var(--ink) 30%, rgb(185 165 255 / 0.45) 82%, rgb(216 184 117 / 0.55) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .ftr__sig { color: var(--gold-text); letter-spacing: 0.16em; font-size: 0.72rem; text-transform: uppercase; }
  .ftr__base { border-image: var(--gold-line) 1; border-top-width: 1px; border-top-style: solid; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.6rem; font-size: var(--step--1); color: var(--ink-3); }
  /* Keep the base line clear of the floating Ask Moguls button. */
  .ftr__base { padding-inline-end: 240px; }
  @media (max-width: 640px) { .ftr__base { padding-inline-end: 0; padding-bottom: 96px; } }
  @media (max-width: 480px) { .ftr__intro :global(.logo) { --lh: 50px !important; } }
  @media (max-width: 900px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__intro { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
