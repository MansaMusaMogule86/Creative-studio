---
// Editorial placeholders only. Each entry is shaped like a future case study
// (title, division, discipline list, hero visual) so real work can replace it
// one-for-one. No clients, results or awards are implied.
import { divisions } from '../data/divisions';
const projects = [
  { id: 'A', division: 'digital', title: 'A commerce platform', disciplines: ['Platform', 'UX/UI', 'E-commerce'], layout: 'wide' },
  { id: 'B', division: 'ai', title: 'An intelligent concierge', disciplines: ['AI agents', 'Voice', 'CRM'], layout: 'tall' },
  { id: 'C', division: 'creative', title: 'A brand world', disciplines: ['Identity', 'Motion', '3D'], layout: 'tall' },
  { id: 'D', division: 'growth', title: 'A launch campaign', disciplines: ['SEO', 'Paid', 'Content'], layout: 'wide' },
].map((p) => ({ ...p, d: divisions.find((d) => d.slug === p.division)! }));
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <header class="work__head">
      <div>
        <p class="eyebrow" data-reveal>Selected work</p>
        <h2 id="work-title" class="h2" data-reveal style="--d:.08s">Case studies, <em>arriving soon.</em></h2>
      </div>
      <p class="work__note" data-reveal style="--d:.16s">
        <strong>Placeholder notice.</strong> The frames below are editorial placeholders that show how projects will be presented. They are not client work.
      </p>
    </header>

    <ul class="work__grid">
      {projects.map((p, i) => (
        <li class={`case case--${p.layout}`} data-reveal style={`--d:${(i % 2) * 0.1}s;--a:${p.d.palette[0]};--b:${p.d.palette[1]};--c:${p.d.palette[2]};--ink-d:${p.d.ink}`}>
          <figure class="case__frame">
            <div class="case__visual" aria-hidden="true">
              <span class="case__shape s1"></span><span class="case__shape s2"></span><span class="case__shape s3"></span>
            </div>
            <span class="case__badge">Placeholder {p.id}</span>
            <figcaption class="case__cap">
              <span class="case__div">{p.d.name}</span>
              <span class="case__title">{p.title}</span>
              <span class="case__tags">{p.disciplines.join(' · ')}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .work__head > div { display: grid; gap: 1.2rem; }
  .work__note { max-width: 40ch; font-size: 0.95rem; color: var(--ink-2); padding: 1rem 1.2rem; border-radius: 16px; border: 1px dashed var(--line-strong); background: var(--white); }
  .work__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(12px, 1.6vw, 24px); }
  .case--wide { grid-column: span 7; } .case--tall { grid-column: span 5; }
  .case:nth-child(3) { grid-column: span 5; } .case:nth-child(4) { grid-column: span 7; }
  .case__frame { margin: 0; position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; background: var(--white); border: 1px solid var(--line); }
  .case--tall .case__frame { aspect-ratio: 4 / 3.6; }
  .case__visual {
    position: absolute; inset: 0;
    background: radial-gradient(90% 80% at 80% 10%, color-mix(in srgb, var(--a) 70%, white), transparent 60%),
      radial-gradient(70% 70% at 10% 100%, color-mix(in srgb, var(--b) 55%, white), transparent 60%), var(--pearl);
    transition: transform 1.4s var(--ease-out);
  }
  .case__shape { position: absolute; border-radius: 50%; mix-blend-mode: multiply; transition: transform 1.4s var(--ease-out), border-radius 1.4s var(--ease-out); }
  .s1 { width: 46%; aspect-ratio: 1; top: 14%; left: 30%; background: linear-gradient(140deg, white, var(--a)); box-shadow: inset -20px -30px 60px rgb(255 255 255 / 0.9); }
  .s2 { width: 26%; aspect-ratio: 1; top: 44%; left: 58%; background: linear-gradient(200deg, white, var(--b)); border-radius: 30%; }
  .s3 { width: 64%; height: 2px; top: 76%; left: 18%; border-radius: 2px; background: var(--ink-d); opacity: 0.25; }
  .case:hover .case__visual { transform: scale(1.04); }
  .case:hover .s1 { transform: translate(-8%, 6%) scale(1.08); border-radius: 42% 58% 50% 50%; }
  .case:hover .s2 { transform: translate(20%, -24%) rotate(45deg); }
  .case__badge { position: absolute; top: 18px; inset-inline-start: 18px; padding: 0.35rem 0.8rem; border-radius: 999px; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 560; background: rgb(255 255 255 / 0.85); border: 1px dashed var(--line-strong); }
  .case__cap { position: absolute; inset: auto 0 0; display: grid; gap: 0.25rem; padding: 1.4rem 1.6rem; background: linear-gradient(transparent, rgb(255 255 255 / 0.92) 40%); }
  .case__div { font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-d); font-weight: 560; }
  .case__title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; }
  .case__tags { font-size: 0.88rem; color: var(--ink-2); }
  @media (max-width: 900px) {
    .work__grid { grid-template-columns: 1fr; }
    .case--wide, .case--tall, .case:nth-child(n) { grid-column: auto; }
    .case__frame, .case--tall .case__frame { aspect-ratio: 4 / 4.2; }
  }
</style>
