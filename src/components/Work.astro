---
// Showcase: one live 3D sculpture per division, modelled in code
// (scripts/division-scenes.ts) and rendered in the visitor's browser.
// These are studio artworks, not client projects: no names, results or
// clients are implied. Pre-rendered stills of the same scenes show first and
// remain the fallback without capable WebGL or with reduced motion.
import { divisions } from '../data/divisions';
const SUBJECT: Record<(typeof divisions)[number]['slug'], string> = {
  digital: 'Cyan glass laptop and holographic globe',
  ai: 'Violet translucent neural intelligence sculpture',
  growth: 'Coral and rose-gold ascending revenue sculpture',
  creative: 'Pink iridescent glass sculpture with ribbons',
  strategy: 'Champagne-gold crystal chess king',
};
const still = (slug: string, w: number) => `/renders/div3d-${slug}-wide-${w}.webp`;
---
<section id="work" class="section show" aria-labelledby="work-title" data-show>
  <div class="wrap">
    <header class="show__head">
      <div>
        <p class="eyebrow" data-reveal>Showcase · in real time</p>
        <h2 id="work-title" class="h2" data-reveal style="--d:.08s">Five worlds, <em>rendered live.</em></h2>
      </div>
      <p class="show__note" data-reveal style="--d:.16s">
        Each division has its own sculpture, modelled in code and rendered in your browser. They are studio artworks, not client projects.
      </p>
    </header>

    <div class="show__body">
      <div class="show__stage" data-show-stage style={`--a:${divisions[0].palette[0]}`}>
        {divisions.map((d, i) => (
          <img class:list={['show__still', { 'is-on': i === 0 }]} data-still={d.slug}
            src={still(d.slug, 600)} srcset={`${still(d.slug, 600)} 600w, ${still(d.slug, 1200)} 1200w`}
            sizes="(max-width: 1023px) calc(100vw - 32px), 60vw" width="1200" height="760" alt="" loading="lazy" decoding="async" />
        ))}
        <span class="show__hint" aria-hidden="true">Move to tilt</span>
      </div>

      <div class="show__side">
        <div class="show__tabs" role="tablist" aria-label="Choose a division sculpture">
          {divisions.map((d, i) => (
            <button type="button" role="tab" id={`show-tab-${d.slug}`} aria-controls="show-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
              data-slug={d.slug} style={`--ink-d:${d.ink};--a:${d.palette[0]};--b:${d.palette[1]}`}>
              <span class="show__idx">{d.index}</span>
              <span class="show__name">{d.short}</span>
            </button>
          ))}
        </div>
        <div class="show__panel" id="show-panel" role="tabpanel" aria-labelledby={`show-tab-${divisions[0].slug}`} aria-live="polite">
          {divisions.map((d, i) => (
            <div class="show__info" data-info={d.slug} hidden={i !== 0} style={`--ink-d:${d.ink};--a:${d.palette[0]}`}>
              <p class="show__div">{d.index} · {d.name}</p>
              <p class="show__subject">{SUBJECT[d.slug]}</p>
              <p class="show__tag">{d.tagline}</p>
              <a class="btn btn--ghost show__cta" href={`/universe/${d.slug}`}>Explore {d.short} <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { liveWebGL, prefersReducedMotion, isSmallScreen } from '../scripts/gpu';
  import type { Stage } from '../scripts/division-stage';
  import type { DivisionSlug } from '../scripts/division-scenes';

  const root = document.querySelector<HTMLElement>('[data-show]');
  if (root) {
    const stageEl = root.querySelector<HTMLElement>('[data-show-stage]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panel = root.querySelector<HTMLElement>('#show-panel')!;
    const stills = [...root.querySelectorAll<HTMLImageElement>('[data-still]')];
    let slug = tabs[0].dataset.slug as DivisionSlug;
    let stage: Stage | null = null;
    let loading: Promise<Stage> | null = null;
    let visible = false;
    const live = liveWebGL();
    const reduce = prefersReducedMotion();
    if (!live) root.classList.add('is-still');

    const ensure = () => stage ? Promise.resolve(stage)
      : (loading ??= import('../scripts/division-stage').then((m) => (stage = m.createStage({ mobile: isSmallScreen(), reduceMotion: reduce }))));

    const render = async () => {
      if (!live || !visible) { stage?.stop(); return; }
      const st = await ensure();
      if (!visible) return;
      st.show(stageEl, slug);
      stageEl.classList.add('is-live');
      if (!document.hidden) st.start();
    };

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      slug = tabs[i].dataset.slug as DivisionSlug;
      panel.setAttribute('aria-labelledby', tabs[i].id);
      root.querySelectorAll<HTMLElement>('[data-info]').forEach((el) => (el.hidden = el.dataset.info !== slug));
      stills.forEach((s) => s.classList.toggle('is-on', s.dataset.still === slug));
      stageEl.style.setProperty('--a', tabs[i].style.getPropertyValue('--a'));
      if (focus) tabs[i].focus();
      // Brief cross-fade from the still while the next scene builds.
      if (stage) { stageEl.classList.remove('is-live'); requestAnimationFrame(() => render()); }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
        if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); select((i - 1 + n) % n, true); }
        if (k === 'Home') { e.preventDefault(); select(0, true); }
        if (k === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });

    // Only render while on screen; three.js is fetched the first time it is needed.
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; render(); }, { rootMargin: '120px' }).observe(stageEl);
    document.addEventListener('visibilitychange', () => (document.hidden ? stage?.stop() : render()));
    addEventListener('pagehide', () => { stage?.dispose(); stage = null; loading = null; stageEl.classList.remove('is-live'); });
    addEventListener('pageshow', (e) => { if (e.persisted) render(); });
  }
</script>

<style>
  .show__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.2rem 3rem; margin-bottom: clamp(1.6rem, 4vw, 3.2rem); }
  .show__head > div { display: grid; gap: 1.1rem; }
  .show__note { max-width: 42ch; color: var(--ink-2); font-size: 0.98rem; }

  .show__body { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(260px, 1fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; }
  .show__stage {
    position: relative; aspect-ratio: 1200 / 760; border-radius: var(--radius); overflow: hidden; isolation: isolate;
    background: color-mix(in srgb, var(--a) 22%, #f8f7ff); border: 1px solid rgb(255 255 255 / 0.95);
    box-shadow: 0 0 0 1px rgb(216 184 117 / 0.35), 0 50px 90px -55px rgb(37 36 60 / 0.55);
    transition: background-color 0.8s var(--ease-out);
  }
  .show__still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .show__still.is-on { opacity: 1; }
  .show__stage :global(.dstage__canvas) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .show__stage:global(.is-live) :global(.dstage__canvas) { opacity: 1; }
  .show__hint { position: absolute; z-index: 2; inset-inline-end: 14px; bottom: 14px; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-2); padding: 0.3rem 0.7rem; border-radius: 999px; background: rgb(255 255 255 / 0.75); opacity: 0; transition: opacity 0.6s; }
  @media (hover: hover) and (pointer: fine) { .show__stage:global(.is-live) .show__hint { opacity: 1; } }
  /* No live WebGL: the real render of the same scene, gently floating. */
  :global(.is-still) .show__still.is-on { animation: show-float 9s var(--ease-in-out) infinite alternate; }
  @keyframes show-float { from { transform: scale(1.02); } to { transform: scale(1.05) translateY(-1.2%); } }

  .show__side { display: grid; gap: 1.4rem; align-content: center; }
  .show__tabs { display: grid; gap: 6px; }
  .show__tabs button {
    display: flex; align-items: baseline; gap: 0.9rem; min-height: 52px; padding: 0.7rem 1rem; border-radius: 16px; cursor: pointer; text-align: start;
    border: 1px solid transparent; background: none; color: var(--ink-3); font-family: var(--font-display); font-size: var(--step-2); line-height: 1;
    transition: color 0.3s, background-color 0.4s, border-color 0.4s;
  }
  .show__tabs button:hover { color: var(--ink); }
  .show__tabs button[aria-selected='true'] { color: var(--ink); border-color: var(--line); background: linear-gradient(90deg, color-mix(in srgb, var(--a) 34%, white), white); }
  .show__idx { font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.12em; }
  .show__tabs button[aria-selected='true'] .show__idx { color: var(--ink-d); }
  .show__info { display: grid; gap: 0.5rem; justify-items: start; padding: 1.2rem 1.3rem; border-radius: 18px; background: var(--white); border: 1px solid var(--line); }
  .show__info[hidden] { display: none; }
  .show__div { font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--ink-d); }
  .show__subject { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.15; color: var(--ink); }
  .show__tag { font-size: 0.9rem; color: var(--ink-2); }
  .show__cta { margin-top: 0.5rem; min-height: 44px; }

  @media (max-width: 1023px) {
    .show__body { grid-template-columns: 1fr; }
    .show__tabs { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: none; gap: 6px; }
    .show__tabs::-webkit-scrollbar { display: none; }
    .show__tabs button { flex: 0 0 auto; scroll-snap-align: start; font-size: 1.25rem; border-color: var(--line); min-height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-still) .show__still.is-on { animation: none; }
    .show__still, .show__stage :global(.dstage__canvas) { transition: none; }
  }
</style>
