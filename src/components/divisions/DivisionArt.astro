---
// A division's 3D artwork. Every stage first shows a pre-rendered still of the
// same scene (scripts/render-stills.mjs); the stage manager then brings the
// single shared WebGL canvas to the active, visible stage on capable devices.
import type { Division } from '../../data/divisions';
interface Props { division: Division; variant?: 'panel' | 'hero'; eager?: boolean }
const { division: d, variant = 'panel', eager = false } = Astro.props;
const sq = (w: number) => `/renders/div3d-${d.slug}-${w}.webp`;
const wide = (w: number) => `/renders/div3d-${d.slug}-wide-${w}.webp`;
---
<div class={`dstage dstage--${variant}`} data-stage={d.slug} style={`--a:${d.palette[0]};--b:${d.palette[1]}`}>
  <picture class="dstage__still" aria-hidden="true">
    <source media="(max-width: 1023px)" srcset={`${wide(600)} 600w, ${wide(1200)} 1200w`} sizes="100vw" width="1200" height="760" />
    <img src={sq(500)} srcset={`${sq(500)} 500w, ${sq(1000)} 1000w`} sizes={variant === 'hero' ? '(max-width: 1440px) 40vw, 560px' : '(max-width: 1440px) 30vw, 420px'}
      width="1000" height="1000" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
  </picture>
</div>

<script>
  import '../../scripts/stage-manager';
</script>

<style>
  .dstage { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: inherit; background: color-mix(in srgb, var(--a) 24%, #f8f7ff); isolation: isolate; }
  .dstage__still, .dstage__still img { display: block; width: 100%; height: 100%; }
  .dstage__still img { object-fit: cover; }
  .dstage :global(.dstage__canvas) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.8s var(--ease-out); }
  .dstage:global(.is-live) :global(.dstage__canvas) { opacity: 1; }
  /* No live WebGL (software GPU, no WebGL): the real render, gently floating. */
  :global(.stage-still) .dstage__still img { animation: dstage-float 9s var(--ease-in-out) infinite alternate; transform-origin: 50% 60%; }
  @keyframes dstage-float { from { transform: scale(1.02) translateY(0) rotate(0deg); } to { transform: scale(1.05) translateY(-1.5%) rotate(-0.6deg); } }
  @media (max-width: 1023px) { .dstage { aspect-ratio: 1200 / 760; } }
  @media (prefers-reduced-motion: reduce) { :global(.stage-still) .dstage__still img { animation: none; } }
</style>
