---
import InquiryForm from './InquiryForm';
---
<section id="contact" class="section ct" aria-labelledby="ct-title">
  <div class="ct__glow" aria-hidden="true"></div>
  <div class="wrap ct__grid">
    <div class="ct__intro">
      <p class="eyebrow" data-reveal>Start a project</p>
      <h2 id="ct-title" class="ct__title" data-reveal style="--d:.08s">Your next big idea <em class="holo-text">starts here.</em></h2>
      <p class="lede" data-reveal style="--d:.16s">Tell us where you want to go. The team reads every inquiry and replies with a clear next step.</p>
      <ol class="ct__steps" data-reveal style="--d:.24s">
        <li><span>01</span>Share the challenge</li>
        <li><span>02</span>We review it and reply</li>
        <li><span>03</span>A discovery conversation</li>
      </ol>
    </div>
    <div class="ct__card"><InquiryForm client:visible /></div>
  </div>
</section>
<style>
  .ct { overflow: hidden; }
  .ct__glow { position: absolute; inset: 10% -10% auto auto; width: 60vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(185 165 255 / 0.35), rgb(142 231 232 / 0.2) 40%, transparent 70%); filter: blur(30px); z-index: -1; }
  .ct__grid { display: grid; grid-template-columns: 0.9fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .ct__intro { position: sticky; top: 120px; display: grid; gap: 1.4rem; }
  .ct__title { font-family: var(--font-display); font-size: var(--step-4); line-height: 0.92; text-transform: uppercase; letter-spacing: -0.02em; }
  .ct__title em { text-transform: none; display: block; }
  .ct__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .ct__steps li { display: flex; gap: 1rem; align-items: baseline; padding-block: 0.7rem; border-bottom: 1px solid var(--line); }
  .ct__steps span { font-size: 0.74rem; letter-spacing: 0.14em; color: var(--ink-3); }
  .ct__card { padding: clamp(1.2rem, 3vw, 2.4rem); border-radius: calc(var(--radius) + 6px); background: rgb(255 255 255 / 0.66); border: 1px solid #fff; box-shadow: 0 50px 100px -60px rgb(37 36 60 / 0.5); backdrop-filter: blur(20px); }
  @media (max-width: 960px) { .ct__grid { grid-template-columns: 1fr; } .ct__intro { position: static; } }
</style>
