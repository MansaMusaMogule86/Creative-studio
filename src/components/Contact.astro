---
import InquiryForm from './InquiryForm';
import Living from './ui/Living.astro';
import { brand } from '../config/brand';
import MessageCircleMore from '@lucide/astro/icons/message-circle-more';
import Layers from '@lucide/astro/icons/layers';
import Rocket from '@lucide/astro/icons/rocket';
import ArrowRight from '@lucide/astro/icons/arrow-right';
const steps = [
  { n: '01', t: 'Share the challenge', I: MessageCircleMore },
  { n: '02', t: 'We review it and reply', I: Layers },
  { n: '03', t: 'Move forward together', I: Rocket },
];
---
<section id="contact" class="section ct" aria-labelledby="ct-title">
  <div class="ct__veil" aria-hidden="true"></div>
  <div class="wrap ct__grid">
    <div class="ct__intro">
      <!-- The official crowned M, floating in 3D with its reflection. -->
      <div class="ct__emblem" data-reveal>
        <Living tilt={1.3} shadow={false} glare={false} class="ct__live">
          <img src={brand.emblem.light[320]} srcset={`${brand.emblem.light[320]} 340w, ${brand.emblem.light[720]} 764w`} sizes="(max-width: 960px) 62vw, 300px"
            width="1273" height="1200" alt="" loading="lazy" decoding="async" />
        </Living>
        <img class="ct__reflect" src={brand.emblem.light[320]} width="1273" height="1200" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      </div>
      <p class="eyebrow" data-reveal>Start a project</p>
      <h2 id="ct-title" class="ct__title" data-reveal style="--d:.08s">Your next big idea <em class="holo-text">starts here.</em></h2>
      <p class="lede" data-reveal style="--d:.16s">Tell us where you want to go. The team reads every inquiry and replies with a clear next step.</p>
      <ol class="ct__steps" data-reveal style="--d:.24s">
        {steps.map((st, i) => (
          <li class="ct__step" style={`--i:${i}`}>
            <span class="ct__stepTop"><span class="ct__n">{st.n}</span><st.I class="ct__icon" size={30} stroke-width={1.6} aria-hidden="true" /></span>
            <span class="ct__t">{st.t}</span>
          </li>
        ))}
      </ol>
      <a class="btn btn--glow ct__cta" href="#inquiry">Start a project <ArrowRight size={20} stroke-width={1.8} aria-hidden="true" /></a>
    </div>
    <div class="ct__card" id="inquiry" tabindex="-1"><InquiryForm client:visible /></div>
  </div>
</section>
<style>
  .ct { overflow: hidden; }
  .ct { isolation: isolate; }
  /* Soft violet light field behind the section (no ribbon artwork). */
  .ct__veil { position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 40% at 20% 10%, rgb(201 182 255 / 0.45), transparent 70%), radial-gradient(50% 40% at 90% 60%, rgb(159 233 255 / 0.3), transparent 70%), radial-gradient(40% 30% at 10% 90%, rgb(255 214 184 / 0.3), transparent 70%); }
  .ct__emblem { position: relative; width: min(62vw, 300px); justify-self: center; margin-bottom: 0.6rem; }
  .ct__emblem :global(.ct__live) img { display: block; width: 100%; height: auto; filter: drop-shadow(0 24px 34px rgb(167 122 48 / 0.35)) drop-shadow(0 0 30px rgb(201 182 255 / 0.55)); }
  /* Mirror reflection on the glass floor. */
  .ct__reflect { position: absolute; left: 0; top: 100%; width: 100%; height: auto; transform: scaleY(-1); opacity: 0.22; filter: blur(2px);
    -webkit-mask: linear-gradient(to top, #000, transparent 45%); mask: linear-gradient(to top, #000, transparent 45%); margin-top: -6%; pointer-events: none; }
  .ct__grid { display: grid; grid-template-columns: 0.9fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .ct__intro { position: sticky; top: 120px; display: grid; gap: 1.4rem; }
  .ct__title { font-family: var(--font-display); font-size: var(--step-4); line-height: 0.92; text-transform: uppercase; letter-spacing: -0.02em; }
  .ct__title em { text-transform: none; display: block; }
  /* Frosted glass step cards. */
  .ct__steps { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .ct__step {
    position: relative; display: grid; gap: 0.7rem; align-content: start; padding: 1rem 0.9rem 1.1rem; border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.45)); backdrop-filter: blur(14px);
    border: 1px solid rgb(255 255 255 / 0.95); box-shadow: inset 0 1px 0 #fff, 0 18px 36px -24px rgb(90 63 192 / 0.45);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .ct__step:hover { transform: translateY(-4px); box-shadow: inset 0 1px 0 #fff, 0 26px 44px -24px rgb(90 63 192 / 0.55); }
  .ct__step:not(:last-child)::after { content: '›'; position: absolute; inset-inline-end: -0.62rem; top: 50%; translate: 0 -50%; color: #5a3fc0; font-size: 1.3rem; }
  .ct__stepTop { display: flex; align-items: center; gap: 0.7rem; }
  .ct__n { font-size: 1rem; font-weight: 600; color: #5a3fc0; letter-spacing: 0.04em; }
  .ct__step :global(.ct__icon) { color: #6b4fd8; filter: drop-shadow(0 4px 8px rgb(107 79 216 / 0.35)); }
  .ct__t { font-size: 0.95rem; line-height: 1.3; color: var(--ink); }
  .ct__cta { justify-self: start; margin-top: 0.6rem; }
  @media (max-width: 960px) { .ct__cta { justify-self: center; width: min(100%, 360px); } }
  @media (max-width: 400px) { .ct__steps { gap: 0.5rem; } .ct__step { padding: 0.8rem 0.7rem 0.9rem; } .ct__t { font-size: 0.86rem; } .ct__step:not(:last-child)::after { display: none; } }
  .ct__card { padding: clamp(1.2rem, 3vw, 2.4rem); border-radius: calc(var(--radius) + 6px); background: rgb(255 255 255 / 0.66); border: 1px solid #fff; box-shadow: 0 50px 100px -60px rgb(37 36 60 / 0.5); backdrop-filter: blur(20px); }
  @media (max-width: 960px) { .ct__grid { grid-template-columns: 1fr; } .ct__intro { position: static; } }
</style>
