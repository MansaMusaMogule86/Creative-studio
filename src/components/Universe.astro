---
import DivisionArt from './divisions/DivisionArt.astro';
import { divisions } from '../data/divisions';
---
<section id="universe" class="section uni" aria-labelledby="uni-title">
  <div class="wrap">
    <header class="uni__head">
      <p class="eyebrow" data-reveal>The universe</p>
      <h2 id="uni-title" class="h2" data-reveal style="--d:.08s">Five divisions. <em>One connected</em> system.</h2>
      <p class="lede" data-reveal style="--d:.16s">Each world has its own craft and character. Together they cover the full path from idea to growth.</p>
    </header>

    <div class="uni__panels" data-universe>
      {divisions.map((d, i) => (
        <article class:list={['panel', { 'is-active': i === 0 }]} style={`--a:${d.palette[0]};--b:${d.palette[1]};--ink-d:${d.ink}`} data-panel>
          {/* Phones and tablets: every division's artwork is visible without tapping. */}
          <div class="panel__thumb" aria-hidden="true" data-thumb><DivisionArt division={d} /></div>
          <h3 class="panel__h">
            <button type="button" class="panel__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`panel-${d.slug}`}>
              <span class="panel__idx">{d.index}</span>
              <span class="panel__title"><span class="panel__name">{d.name}</span><span class="panel__sub">{d.tagline}</span></span>
              <span class="panel__plus" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="panel__body" id={`panel-${d.slug}`}>
            <div class="panel__inner">
            <div class="panel__art"><DivisionArt division={d} /></div>
            <div class="panel__copy">
              <p class="panel__tag">{d.tagline}</p>
              <p class="panel__intro">{d.intro}</p>
              <ul class="panel__list">
                {d.services.slice(0, 4).map((s) => <li><a href={`/universe/${d.slug}#${s.slug}`}>{s.title}</a></li>)}
              </ul>
              <a class="panel__enter" href={`/universe/${d.slug}`}>Enter {d.name} <span aria-hidden="true">→</span></a>
            </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-universe]');
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const desktop = matchMedia('(min-width: 1024px)');
    // Tapping a division's artwork card opens it, just like its title row.
    panels.forEach((q) => q.querySelector('[data-thumb]')?.addEventListener('click', () => q.querySelector<HTMLButtonElement>('.panel__btn')!.click()));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sync = () => panels.forEach((q) => {
      // Collapsed accordion bodies are hidden from keyboard and screen readers on small screens.
      (q.querySelector('.panel__body') as HTMLElement).inert = !desktop.matches && !q.classList.contains('is-active');
    });
    const activate = (p: HTMLElement, toggle = false) => {
      const open = toggle && !desktop.matches ? !p.classList.contains('is-active') : true;
      if (desktop.matches && p.classList.contains('is-active')) return;
      panels.forEach((q) => {
        const on = q === p ? open : false;
        q.classList.toggle('is-active', on);
        if (on) q.dataset.opened = '';
        q.querySelector('button')!.setAttribute('aria-expanded', String(on));
      });
      sync();
      dispatchEvent(new CustomEvent('universe:active'));
      // Mobile: if collapsing a panel above pushed the opened one out of view,
      // bring its header back just below the floating site header.
      if (!desktop.matches && open) {
        setTimeout(() => {
          const top = p.getBoundingClientRect().top;
          if (top < 84) scrollBy({ top: top - 92, behavior: reduce ? 'auto' : 'smooth' });
        }, reduce ? 0 : 480);
      }
    };
    sync();
    panels.forEach((p) => {
      p.querySelector('button')!.addEventListener('click', () => activate(p, true));
      p.addEventListener('pointerenter', (e) => { if (desktop.matches && e.pointerType === 'mouse') activate(p); });
      p.addEventListener('focusin', () => { if (desktop.matches) activate(p); });
    });
    // Desktop always keeps one world open.
    desktop.addEventListener('change', () => { if (!panels.some((p) => p.classList.contains('is-active'))) activate(panels[0]); sync(); });
  }
</script>

<style>
  .uni__head { display: grid; gap: 1.2rem; max-width: 920px; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }

  .uni__panels { display: flex; gap: 12px; height: min(78vh, 720px); min-height: 600px; }
  .panel {
    position: relative; flex: 1 1 0; min-width: 0; border-radius: var(--radius); overflow: hidden;
    background: linear-gradient(170deg, var(--white) 0%, color-mix(in srgb, var(--a) 16%, var(--white)) 100%);
    border: 1px solid var(--line); transition: flex-grow 0.9s var(--ease-out), background 0.9s, box-shadow 0.9s;
    display: flex; flex-direction: column;
  }
  .panel::before { content: ''; position: absolute; inset: 0 12% auto; height: 1.5px; background: var(--gold-line); opacity: 0; transform: scaleX(0.4); transition: opacity 0.6s, transform 0.9s var(--ease-out); z-index: 1; }
  .panel.is-active::before { opacity: 1; transform: none; }
  .panel.is-active {
    flex-grow: 4.2;
    background: linear-gradient(160deg, var(--white) 0%, color-mix(in srgb, var(--a) 38%, var(--white)) 55%, color-mix(in srgb, var(--b) 30%, var(--white)) 100%);
    box-shadow: 0 40px 80px -50px color-mix(in srgb, var(--ink-d) 60%, transparent);
  }
  .panel__h { font: inherit; }
  .panel__btn {
    width: 100%; display: flex; align-items: center; gap: 0.9rem; padding: 1.5rem 1.6rem;
    background: none; border: 0; cursor: pointer; text-align: start;
  }
  .panel__idx { font-size: 0.78rem; letter-spacing: 0.14em; color: var(--ink-d); font-weight: 600; }
  .panel__name { font-family: var(--font-display); font-size: clamp(1.4rem, 1.1rem + 0.8vw, 2.1rem); line-height: 1; white-space: nowrap; }
  .panel__plus { margin-inline-start: auto; width: 14px; height: 14px; position: relative; flex-shrink: 0; }
  .panel__plus::before, .panel__plus::after { content: ''; position: absolute; inset: 6px 0; background: currentColor; transition: transform 0.5s var(--ease-out); }
  .panel__plus::after { transform: rotate(90deg); }
  .panel.is-active .panel__plus::after { transform: rotate(0); }

  .panel__body { flex: 1; display: grid; grid-template-rows: 1fr auto; padding: 0 1.6rem 1.6rem; min-height: 0; }
  .panel__art { display: grid; place-items: center; min-height: 0; }
  .panel__art { width: 100%; height: 100%; }
  .panel__art :global(.dart-live) { width: min(100%, 440px); margin-inline: auto; border-radius: 22px; box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--ink-d) 55%, transparent); }
  .panel__sub { display: none; }
  .panel__thumb { display: none; }
  .panel__copy { display: grid; gap: 0.8rem; align-content: end; }
  .panel__tag { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 560; color: var(--ink-d); }
  .panel__intro { color: var(--ink-2); max-width: 46ch; }
  .panel__list { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .panel__list a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 0.86rem; text-decoration: none;
    background: rgb(255 255 255 / 0.7); border: 1px solid var(--line); transition: background-color 0.3s, border-color 0.3s;
  }
  .panel__list a:hover { background: var(--white); border-color: var(--line-strong); }
  .panel__enter {
    justify-self: start; margin-top: 0.4rem; font-weight: 560; font-size: 0.86rem; letter-spacing: 0.14em; text-transform: uppercase;
    text-decoration: none; padding-block: 0.6rem; border-bottom: 1px solid currentColor; color: var(--ink-d);
  }
  .panel__enter span { display: inline-block; transition: transform 0.4s var(--ease-out); }
  .panel__enter:hover span { transform: translateX(5px); }

  /* Desktop: collapsed panels show a vertical label and only the artwork. */
  @media (min-width: 1024px) {
    .panel:not(.is-active) .panel__btn { flex-direction: column; align-items: flex-start; height: 100%; }
    .panel:not(.is-active) .panel__name { writing-mode: vertical-rl; rotate: 180deg; margin-top: auto; }
    .panel:not(.is-active) .panel__plus { position: absolute; top: 1.6rem; inset-inline-end: 1.4rem; }
    .panel__inner { display: contents; }
    .panel__title { display: contents; }
    .panel:not(.is-active) .panel__body { position: absolute; inset: auto 0 4%; padding: 0 8%; opacity: 0.9; pointer-events: none; }
    .panel:not(.is-active) .panel__art :global(.dart-live) { border-radius: 16px; box-shadow: none; }
    .panel:not(.is-active) .panel__copy { display: none; }
    .panel.is-active .panel__body { grid-template-columns: 1.05fr 1fr; grid-template-rows: 1fr; gap: 1.5rem; align-items: end; animation: panel-in 0.9s var(--ease-out) both; }
    .panel.is-active .panel__art { align-self: center; }
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(14px); } }

  /* Mobile & tablet: a compact, animated accordion, one world at a time.
     Bodies animate with grid-template-rows (0fr → 1fr) so nothing jumps. */
  @media (max-width: 1023px) {
    .uni__head { margin-bottom: 1.8rem; }
    .uni__panels { flex-direction: column; height: auto; min-height: 0; gap: 10px; }
    .panel, .panel.is-active { flex: none; border-radius: 22px; scroll-margin-top: 92px; }
    .panel__btn { padding: 1rem 1rem 1rem 1.15rem; gap: 0.85rem; min-height: 72px; }
    .panel__title { display: grid; gap: 0.25rem; min-width: 0; }
    .panel__name { white-space: normal; font-size: 1.45rem; }
    .panel__sub { display: block; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
    .panel__plus { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(255 255 255 / 0.7); }
    .panel__plus::before, .panel__plus::after { inset: 19px 13px; }
    .panel.is-active .panel__plus { border-color: var(--gold-champagne); background: var(--gold-light); }
    .panel__body { display: grid; grid-template-rows: 0fr; padding: 0 1rem; transition: grid-template-rows 0.45s var(--ease-out), padding 0.45s var(--ease-out); }
    .panel.is-active .panel__body { grid-template-rows: 1fr; padding-bottom: 1rem; }
    .panel__inner { min-height: 0; overflow: hidden; display: grid; gap: 1rem; }
    .panel__art { height: auto; }
    .panel__art :global(.dart-live) { width: 100%; border-radius: 16px; }
    /* The artwork card sits above each title, always visible; the copy expands below. */
    .panel__thumb { display: block; padding: 0.7rem 0.7rem 0; cursor: pointer; }
    .panel__thumb :global(.dart-live) { border-radius: 16px; }
    .panel__thumb :global(.dart) { box-shadow: 0 20px 40px -30px color-mix(in srgb, var(--ink-d) 70%, transparent); }
    .panel__art { display: none; }
    .panel__copy { gap: 0.7rem; opacity: 0; transform: translateY(8px); transition: opacity 0.35s, transform 0.45s var(--ease-out); }
    .panel.is-active .panel__copy { opacity: 1; transform: none; transition-delay: 0.12s; }
    .panel__tag { display: none; }
    .panel__intro { font-size: 0.98rem; }
    .panel__list a { font-size: 0.84rem; }
  }
  @media (max-width: 1023px) and (prefers-reduced-motion: reduce) { .panel__body, .panel__copy { transition: none; } }
</style>
