---
import { brand } from '../config/brand';
import { divisions, allServices } from '../data/divisions';
// Facts only: every figure here is derived from our own data, never invented.
const facts = [
  { k: brand.city, v: 'Home base' },
  { k: String(divisions.length).padStart(2, '0'), v: 'Connected divisions' },
  { k: String(allServices.length), v: 'Services under one roof' },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__ambient" aria-hidden="true"></div>

  <div class="wrap hero__grid">
    <!-- Left: statement -->
    <div class="hero__main">
      <dl class="hero__facts hero__in" style="--d:.05s">
        {facts.map((f) => <div><dt>{f.v}</dt><dd>{f.k}</dd></div>)}
      </dl>

      <h1 id="hero-title" class="hero__title">
        <span class="line"><span class="hero__in" style="--d:.18s">We architect</span></span>
        <span class="line"><em class="hero__in holo-text" style="--d:.32s">what’s next.</em></span>
      </h1>

      <div class="hero__foot">
        <div class="hero__copy hero__in" style="--d:.48s">
          <p class="hero__kicker">Design · Intelligence · Technology · Growth</p>
          <p class="lede">We unite design, intelligence, technology, and growth to build extraordinary digital experiences and businesses ready for tomorrow.</p>
          <div class="hero__ctas">
            <a href="#universe" class="btn" data-magnetic>Explore our universe <span class="arrow" aria-hidden="true">→</span></a>
            <a href="#contact" class="btn btn--ghost">Start a project</a>
          </div>
        </div>
        <a href="#universe" class="hero__round hero__in" style="--d:.6s" aria-label="Scroll to the five divisions">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 9v8H9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    <!-- Right: bento -->
    <div class="bento">
      <article class="tile tile--team hero__in" style="--d:.3s">
        <p class="tile__big">One team.<br /><em>Five worlds.</em></p>
        <ul class="tile__dots" aria-label="Divisions">
          {divisions.map((d) => <li style={`--c:${d.palette[0]};--c2:${d.palette[1]}`} title={d.name}><span class="sr-only">{d.name}</span></li>)}
        </ul>
      </article>

      <article class="tile tile--ask gold-trace hero__in" style="--d:.38s">
        <p class="tile__h">Not sure where to start?</p>
        <p class="tile__p">Describe your challenge and our service finder points you to the right division.</p>
        <button type="button" class="tile__btn" data-open-ask>Ask Moguls <span aria-hidden="true">↗</span></button>
      </article>

      <article class="tile tile--stage gold-trace hero__in" style="--d:.46s">
        <picture class="stage__fallback" aria-hidden="true">
          <source media="(max-width: 640px)" srcset="/renders/hero-card-mobile-350.webp 350w, /renders/hero-card-mobile-700.webp 700w" sizes="100vw" />
          <img src="/renders/hero-card-660.webp" srcset="/renders/hero-card-660.webp 660w, /renders/hero-card-1320.webp 1320w" sizes="(max-width: 1100px) 100vw, 50vw" alt="" width="1320" height="760" decoding="async" fetchpriority="high" />
        </picture>
        <canvas class="stage__canvas" data-sculpture aria-hidden="true"></canvas>
        <div class="stage__top">
          <span class="chip chip--glass">The universe</span>
          <span class="chip">01 — 05</span>
        </div>
        <nav class="stage__pills" aria-label="Divisions">
          <ul>
            {divisions.map((d, i) => (
              <li style={`--i:${i}`}>
                <a href={`/universe/${d.slug}`} style={`--ink-d:${d.ink};--a:${d.palette[0]}`}>
                  {d.short}<span aria-hidden="true">↘</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <span class="stage__sweep" aria-hidden="true"></span>
        <p class="stage__label">Liquid glass study · the artistic centrepiece of the Mansas Moguls universe</p>
      </article>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-sculpture]');
  // Real-time 3D only on hardware GPUs. Software rasterisers (SwiftShader,
  // llvmpipe…) render the glass on the CPU and block the main thread, so those
  // devices keep the pre-rendered still instead.
  const supportsGL = (() => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const renderer = String(info ? gl.getParameter(info.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER));
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      // ?force-webgl lets QA and design review see the live scene on GPU-less machines.
      if (new URLSearchParams(location.search).has('force-webgl')) return true;
      return !/swiftshader|llvmpipe|softpipe|software|basic render/i.test(renderer);
    } catch { return false; }
  })();
  document.documentElement.dataset.webgl = String(supportsGL);
  if (canvas && supportsGL) {
    const boot = async () => {
      const { mountSculpture } = await import('../scripts/sculpture');
      mountSculpture(canvas, {
        reduceMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
        mobile: matchMedia('(max-width: 767px), (pointer: coarse)').matches,
      });
      requestAnimationFrame(() => canvas.classList.add('is-ready'));
    };
    'requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 600 }) : setTimeout(boot, 200);
  }
  document.querySelectorAll('[data-open-ask]').forEach((b) =>
    b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('moguls:ask-open', { detail: { opener: b } }))),
  );
</script>

<style>
  .hero { position: relative; min-height: 100svh; padding-block: 112px 40px; display: grid; align-items: center; isolation: isolate; overflow: hidden; }
  .hero__ambient {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(40% 50% at 80% 10%, rgb(185 165 255 / 0.28), transparent 70%),
      radial-gradient(35% 45% at 0% 100%, rgb(255 198 172 / 0.22), transparent 70%),
      radial-gradient(30% 40% at 100% 100%, rgb(142 231 232 / 0.24), transparent 70%);
    animation: drift 24s var(--ease-in-out) infinite alternate;
  }
  @keyframes drift { to { transform: translate3d(-2%, 2%, 0) scale(1.05); } }

  .hero__grid { display: grid; grid-template-columns: 1fr 1.02fr; gap: clamp(1.5rem, 3vw, 3rem); align-items: stretch; }

  /* ── Statement ── */
  .hero__main { display: grid; grid-template-rows: auto 1fr auto; gap: 2rem; min-width: 0; }
  .hero__facts { position: relative; display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 1rem; margin: 0; padding-bottom: 1.4rem; }
  .hero__facts::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: linear-gradient(90deg, var(--gold-antique), var(--gold-champagne) 30%, rgb(216 184 117 / 0.15)); }
  .hero__facts div { display: flex; flex-direction: column-reverse; gap: 0.2rem; }
  .hero__facts dd { margin: 0; font-family: var(--font-display); font-style: italic; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem); line-height: 1; }
  .hero__facts dt { font-size: 0.8rem; color: var(--ink-2); }
  .hero__title {
    align-self: center; font-family: var(--font-display); font-size: clamp(3.3rem, 1.2rem + 6.6vw, 8.6rem);
    line-height: 0.88; letter-spacing: -0.025em; text-transform: uppercase;
  }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero__title .line > * { display: inline-block; }
  .hero__title em { text-transform: none; font-size: 1.04em; }
  .hero__foot { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  .hero__copy { display: grid; gap: 1rem; }
  .hero__kicker { font-family: var(--font-display); font-style: italic; font-size: var(--step-1); }
  .hero__copy .lede { font-size: var(--step-0); max-width: 44ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.4rem; }
  .hero__round {
    flex-shrink: 0; width: 84px; height: 84px; border-radius: 50%; border: 1.4px solid var(--ink); display: grid; place-items: center;
    transition: background-color 0.4s, color 0.4s, transform 0.6s var(--ease-out);
  }
  .hero__round svg { width: 34px; }
  .hero__round:hover { background: var(--ink); color: var(--white); transform: rotate(-45deg); }

  /* ── Bento ── */
  .bento { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto minmax(380px, 1fr); gap: 14px; min-width: 0; }
  .tile { position: relative; border-radius: 30px; padding: 1.6rem; background: rgb(255 255 255 / 0.72); border: 1px solid rgb(255 255 255 / 0.95); box-shadow: 0 30px 60px -45px rgb(37 36 60 / 0.45); overflow: hidden; }
  .tile--team { display: grid; align-content: space-between; gap: 1.6rem; background: linear-gradient(160deg, #fff, #f1edff); }
  .tile__big { font-family: var(--font-display); font-size: clamp(1.9rem, 1.2rem + 1.6vw, 3rem); line-height: 0.95; }
  .tile__big em { color: #5a3fc0; }
  .tile__dots { display: flex; }
  .tile__dots li { width: 38px; height: 38px; border-radius: 50%; margin-inline-end: -8px; border: 3px solid #fff; background: radial-gradient(circle at 30% 30%, #fff, var(--c) 55%, var(--c2)); box-shadow: 0 6px 14px -6px rgb(37 36 60 / 0.4); }
  .tile--ask { display: grid; align-content: start; gap: 0.6rem; }
  .tile__h { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  .tile__p { font-size: 0.9rem; color: var(--ink-2); line-height: 1.5; }
  .tile__btn { justify-self: start; margin-top: 0.4rem; min-height: 44px; padding: 0 1.1rem; border-radius: 999px; border: 1px solid var(--ink); background: none; cursor: pointer; font-size: 0.8rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; transition: background-color 0.3s, color 0.3s; }
  .tile__btn:hover { background: var(--ink); color: #fff; }

  .tile--stage { grid-column: 1 / -1; padding: 0; min-height: 380px; background: #ece8ff; }
  /* A locally rendered still of the same sculpture: shown before WebGL boots and when it can't. */
  .stage__fallback { position: absolute; inset: 0; background: #f1eeff; }
  .stage__fallback img { width: 100%; height: 100%; object-fit: cover; object-position: 75% 50%; }
  /* Champagne ambient light behind the sculpture (static; no loop). */
  .tile--stage::before { content: ''; position: absolute; inset: 8% 6% 14% 30%; z-index: 0; border-radius: 50%; background: radial-gradient(closest-side, rgb(245 229 186 / 0.55), rgb(216 184 117 / 0.18) 55%, transparent); filter: blur(24px); pointer-events: none; }
  .stage__fallback, .stage__canvas { z-index: 0; }
  .stage__top, .stage__pills, .stage__label { z-index: 2; }
  /* One delicate gold light sweep on entrance, and again when hovered. */
  .stage__sweep { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: var(--gold-sheen); background-size: 300% 100%; background-position: 150% 0; mix-blend-mode: soft-light; opacity: 0.9; }
  .js .stage__sweep { animation: sweep 2.6s var(--ease-in-out) 1.4s 1 both; }
  .tile--stage:hover .stage__sweep { animation: sweep 2.2s var(--ease-in-out) 1 both; }
  @keyframes sweep { from { background-position: 150% 0; } to { background-position: -60% 0; } }
  .stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease-out); }
  .stage__canvas:global(.is-ready) { opacity: 1; }
  .stage__top { position: absolute; top: 18px; inset-inline: 18px; display: flex; gap: 6px; }
  .chip { display: inline-flex; align-items: center; min-height: 34px; padding: 0 1rem; border-radius: 999px; font-size: 0.78rem; font-weight: 520; background: #fff; }
  .chip--glass { background: rgb(255 255 255 / 0.35); border: 1px solid rgb(255 255 255 / 0.9); backdrop-filter: blur(10px); }
  .stage__pills { position: absolute; inset-inline-start: 18px; bottom: 18px; }
  .stage__pills ul { display: grid; gap: 8px; justify-items: start; }
  .stage__pills a {
    display: inline-flex; align-items: center; gap: 0.9rem; min-height: 46px; padding: 0 0.6rem 0 1.2rem; border-radius: 999px;
    background: rgb(255 255 255 / 0.9); backdrop-filter: blur(10px); text-decoration: none; font-size: 1rem; font-weight: 500;
    box-shadow: 0 10px 24px -14px rgb(37 36 60 / 0.5); transition: transform 0.5s var(--ease-out), background-color 0.3s, color 0.3s;
    animation: pill-in 0.9s var(--ease-out) both; animation-delay: calc(0.7s + var(--i) * 70ms);
  }
  .stage__pills a span { width: 28px; height: 28px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 0.85rem; transition: transform 0.5s var(--ease-out), background-color 0.3s; }
  .stage__pills a:hover { transform: translateX(6px); color: var(--ink-d); }
  .stage__pills a:hover span { transform: rotate(-90deg); background: radial-gradient(circle at 35% 30%, var(--gold-light), var(--a) 70%); border-color: var(--gold-champagne); color: var(--ink); }
  @keyframes pill-in { from { opacity: 0; transform: translateX(-14px); } }
  .stage__label { position: absolute; inset-inline-end: 20px; bottom: 18px; font-size: 0.72rem; letter-spacing: 0.06em; color: var(--ink-2); max-width: 20ch; text-align: end; }

  .js .hero__in { opacity: 0; transform: translateY(0.6em); animation: hero-in 1.3s var(--ease-out) forwards; animation-delay: var(--d); }
  .js .hero__title .hero__in { transform: translateY(105%); }
  .js .tile.hero__in { transform: translateY(24px) scale(0.98); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  /* Tablet: statement on top, bento below. */
  @media (max-width: 1100px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__title { font-size: clamp(3rem, 1rem + 9vw, 7rem); margin-block: 1rem; }
    .bento { grid-template-rows: auto 440px; }
  }
  /* Phone: a deliberate single column. Sculpture card first after the
     statement, facts become a compact row, round button hides. */
  @media (max-width: 640px) {
    .hero { padding-top: 96px; }
    .hero__main { gap: 1.3rem; }
    .hero__facts { gap: 0.6rem; }
    .hero__facts dd { font-size: 1.35rem; }
    .hero__facts dt { font-size: 0.72rem; }
    .hero__title { font-size: clamp(2.7rem, 14vw, 4.6rem); margin-block: 0.4rem; }
    .hero__round { display: none; }
    .bento { grid-template-columns: 1fr; grid-template-rows: none; }
    .tile--stage { grid-row: 1; min-height: 0; aspect-ratio: 4 / 4.6; }
    .tile--team { grid-template-columns: 1fr auto; align-items: center; }
    .tile__big { font-size: 1.7rem; }
    .stage__pills a { min-height: 44px; font-size: 0.92rem; }
    .stage__label { display: none; }
  }
  @media (max-width: 380px) { .hero__ctas .btn { width: 100%; } .tile--team { grid-template-columns: 1fr; } }
</style>
